{
    "name": "lceduardo/task-api",
    "description": "API de tarefas em PHP puro",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "ext-soap": "*",
        "robmorgan/phinx": "^0.16.12",
        "vlucas/phpdotenv": "5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\Controller\\": "controller/",
            "App\\Model\\": "model/",
            "App\\Soap\\": "soap/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "scripts": {
        "test": "phpunit"
    }
}
